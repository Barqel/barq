// {{className}} — a mail owned by the module.
//
// The template holds the subject and the bodies; the `{{ placeholders }}`
// are filled from the `data` passed to `send()`. Values are HTML-escaped
// before they reach the body, so user input cannot inject markup.
import {
	injectable,
	mailer,
	type MailAddress,
	type MailSendResult,
	type MailTemplate,
} from "{{package}}";

/** Values for the `{{ placeholders }}` of this mail. */
export type {{className}}Data = {
	name: string;
};

@injectable()
export class {{className}} {
	readonly template: MailTemplate = {
		subject: "Hello {{ name }}",
		html: `<!doctype html>
<html lang="en">
	<body style="margin:0;padding:24px;background:#f4f5f7;font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#111827">
		<p style="margin:0 0 16px;font-size:15px;line-height:1.6">Hello {{ name }},</p>
		<p style="margin:0;font-size:13px;line-height:1.6;color:#6b7280">
			Write the body of this mail here.
		</p>
	</body>
</html>`,
		text: `Hello {{ name }},

Write the body of this mail here.`,
	};

	async send(
		to: MailAddress,
		data: {{className}}Data,
	): Promise<MailSendResult> {
		return mailer().send({ to, template: this.template, data });
	}
}
