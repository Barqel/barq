{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"paths": {
			"@barqel/barq": ["./src/index.ts"],
			"@barqel/barq-rate-limit": ["./packages/rate-limit/src/index.ts"],
			"@barqel/barq-cron": ["./packages/cron/src/index.ts"],
			"@barqel/barq-static": ["./packages/static/src/index.ts"],
			"@barqel/barq-helmet": ["./packages/helmet/src/index.ts"],
			"@barqel/barq-logger": ["./packages/logger/src/index.ts"],
			"@barqel/barq-compress": ["./packages/compress/src/index.ts"],
			"@barqel/barq-idempotency": ["./packages/idempotency/src/index.ts"],
			"@barqel/barq-events": ["./packages/events/src/index.ts"],
			"@barqel/barq-cli": ["./packages/cli/src/index.ts"],
			"@barqel/barq-env": ["./packages/env/src/index.ts"],
			"@barqel/barq-i18n": ["./packages/i18n/src/index.ts"]
		}
	},
	"include": ["src/**/*"]
}
