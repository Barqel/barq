{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"paths": {
			"@barqel/barq": ["./src/index.ts"],
			"@barqel/barq-auth": ["./packages/auth/src/index.ts"],
			"@barqel/barq-rate-limit": ["./packages/rate-limit/src/index.ts"],
			"@barqel/barq-cron": ["./packages/cron/src/index.ts"],
			"@barqel/barq-static": ["./packages/static/src/index.ts"],
			"@barqel/barq-helmet": ["./packages/helmet/src/index.ts"],
			"@barqel/barq-logger": ["./packages/logger/src/index.ts"],
			"@barqel/barq-sse": ["./packages/sse/src/index.ts"],
			"@barqel/barq-compress": ["./packages/compress/src/index.ts"],
			"@barqel/barq-cache": ["./packages/cache/src/index.ts"],
			"@barqel/barq-prometheus": ["./packages/prometheus/src/index.ts"],
			"@barqel/barq-pubsub": ["./packages/pubsub/src/index.ts"],
			"@barqel/barq-proxy": ["./packages/proxy/src/index.ts"],
			"@barqel/barq-upload": ["./packages/upload/src/index.ts"],
			"@barqel/barq-idempotency": ["./packages/idempotency/src/index.ts"],
			"@barqel/barq-versioning": ["./packages/versioning/src/index.ts"],
			"@barqel/barq-zod": ["./packages/zod/src/index.ts"],
			"@barqel/barq-events": ["./packages/events/src/index.ts"],
			"@barqel/barq-cli": ["./packages/cli/src/index.ts"],
			"@barqel/barq-testing": ["./packages/testing/src/index.ts"],
			"@barqel/barq-orm": ["./packages/orm/src/index.ts"],
			"@barqel/barq-orm/sqlite": ["./packages/orm/src/sqlite.ts"],
			"@barqel/barq-orm/mysql": ["./packages/orm/src/mysql.ts"],
			"@barqel/barq-orm/postgres": ["./packages/orm/src/postgres.ts"],
			"@barqel/barq-orm/testing": ["./packages/orm/src/testing.ts"],
			"@barqel/barq-webhooks": ["./packages/webhooks/src/index.ts"],
			"@barqel/barq-client": ["./packages/client/src/index.ts"],
			"@barqel/barq-env": ["./packages/env/src/index.ts"],
			"@barqel/barq-i18n": ["./packages/i18n/src/index.ts"]
		}
	},
	"include": ["src/**/*"]
}
