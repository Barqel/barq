# Environment template — copy to `.env` and adjust.
# Every variable is validated at boot by @barq; the app refuses
# to start with a clear per-variable error when a value is malformed.

# --- Application ---------------------------------------------------------
# development | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000

# Comma-separated list of allowed origins, or "*" to allow all.
# Example: "https://example.com,https://admin.example.com"
APP_CORS_ORIGIN=*

# --- Logging -------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Rate limiting (per client IP) ---------------------------------------
# Global limiter window in ms, max requests per window, and the strict
# limit applied to sensitive write routes.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_STRICT_MAX=20

# --- Idempotency (write routes) ------------------------------------------
# Response TTL per Idempotency-Key, and whether the header is required.
IDEMPOTENCY_TTL_MS=86400000
IDEMPOTENCY_ENFORCE_HEADER=true

# --- API key guard (modules/shared/middleware/api-key.ts) ----------------
# When set, write routes require a matching `x-api-key` header.
# Leave empty to keep the guard off (dev / test friendly).
API_KEY=

# --- Encryption (Crypt) ---------------------------------------------------
# The key that encrypts and decrypts values — AES-256-CBC + HMAC-SHA256.
# Generate one with: bun run cli key:generate
APP_KEY="base64:REPLACE_ME_WITH_THE_GENERATED_KEY="
# Retired keys, comma-separated: decryption falls back to them, so rotating
# the key never breaks the values already stored.
APP_PREVIOUS_KEYS=

# --- Password hashing (Hash) ----------------------------------------------
# scrypt (default — works on Bun and Node.js) | bcrypt | argon2id
HASH_DRIVER=scrypt
# Set to false to accept hashes made with another algorithm (migrations).
HASH_VERIFY=true

# --- Mail (email plugin) --------------------------------------------------
# The transport is picked automatically: a host means real SMTP delivery,
# no host means the message is printed in the terminal instead of sent.
# auto | smtp | log | json | stream | sendmail
MAIL_TRANSPORT=auto
MAIL_HOST=
MAIL_PORT=587
# TLS from the first byte (true on port 465).
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="Barq Starter Kit"
MAIL_REPLY_TO=
# A prefix added to every subject, e.g. "[Starter Kit] ".
MAIL_SUBJECT_PREFIX=
# How many times a failed send is retried, and the delay before the first one.
MAIL_RETRIES=2
MAIL_RETRY_DELAY=500
