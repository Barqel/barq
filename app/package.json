{
	"name": "app",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --watch run index.ts",
		"start": "bun run index.ts",
		"cli": "bun node_modules/@barqel/barq-app/bin/barq.js",
		"cli:node": "node node_modules/@barqel/barq-app/bin/barq.js",
		"build": "bun build index.ts --target=bun --outdir=dist --minify --external @barq --external @barqel/barq-app",
		"start:prod": "bun run dist/index.js",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"dependencies": {
		"@barqel/barq": "file:../barq",
		"@barqel/barq-app": "file:../barq/packages/app",
		"nodemailer": "^10.1.7"
	}
}
