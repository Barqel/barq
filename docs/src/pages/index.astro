<script>
  // Determine target locale from referrer, cookie, or browser preference
  function getTargetLocale(): string {
    const supportedLangs = ['en', 'ar'];
    
    // 1. Check referrer - if coming from a localized path, stay in that locale
    const referrer = document.referrer;
    if (referrer) {
      const referrerUrl = new URL(referrer);
      const referrerLocale = referrerUrl.pathname.split('/')[1];
      if (supportedLangs.includes(referrerLocale)) {
        return referrerLocale;
      }
    }
    
    // 2. Check saved locale cookie
    const savedLang = document.cookie.split('; ').find(row => row.startsWith('starlight-locale='))?.split('=')[1];
    if (savedLang && supportedLangs.includes(savedLang)) {
      return savedLang;
    }
    
    // 3. Use browser language preference
    const acceptLang = navigator.language.split('-')[0].toLowerCase();
    if (supportedLangs.includes(acceptLang)) {
      return acceptLang;
    }
    
    // 4. Default to English
    return 'en';
  }

  const targetLang = getTargetLocale();
  window.location.href = `/${targetLang}/`;
</script>

<noscript>
  <meta http-equiv="refresh" content="0; url=/en/" />
</noscript>

