---
import context from 'virtual:starlight/project-context';
import config from 'virtual:starlight/user-config';
import Select from '@astrojs/starlight/components/Select.astro';

/**
 * Get the equivalent of the current page path for the passed locale.
 */
function localizedPathname(locale: string | undefined): string {
  try {
    const url = new URL(Astro.url);
    if (!config.locales) return url.pathname;
    if (locale === "root") locale = "";
    
    const base = new URL(import.meta.env.BASE_URL).pathname.replace(/\/$/, "");
    const hasBase = url.pathname.startsWith(base);
    if (hasBase) url.pathname = url.pathname.replace(base, "");
    
    const [_leadingSlash, baseSegment] = url.pathname.split("/");
    const isRootHtml = baseSegment?.endsWith(".html");
    const baseSlug = isRootHtml ? baseSegment?.slice(0, -5) : baseSegment;
    
    if (baseSlug && baseSlug in config.locales) {
      if (locale) url.pathname = url.pathname.replace(baseSlug, locale);
      else if (isRootHtml) url.pathname = "/index.html";
      else url.pathname = url.pathname.replace("/" + baseSlug, "");
    } else if (locale) {
      if (baseSegment === "index.html") url.pathname = "/" + locale + ".html";
      else url.pathname = "/" + locale + url.pathname;
    }
    
    if (hasBase) url.pathname = base + url.pathname;
    if (context.trailingSlash === "never") url.pathname = url.pathname.replace(/\/$/, "");
    
    return url.pathname;
  } catch {
    // Fallback for prerendering when Astro.url might not be available
    return locale ? `/${locale}/` : "/";
  }
}
---

{
	config.isMultilingual && (
		<starlight-lang-select>
			<Select
				icon="translate"
				label={Astro.locals.t('languageSelect.accessibleLabel')}
				options={Object.entries(config.locales).map(([code, locale]) => ({
					value: localizedPathname(code),
					selected: code === Astro.locals.starlightRoute.locale,
					label: locale!.label,
				}))}
				width="7em"
			/>
		</starlight-lang-select>
	)
}

<script>
	class StarlightLanguageSelect extends HTMLElement {
		constructor() {
			super();
			const select = this.querySelector('select');
			if (select) {
				select.addEventListener('change', (e) => {
					if (e.currentTarget instanceof HTMLSelectElement) {
						const newPath = e.currentTarget.value;
						// Extract locale from path (e.g., "/ar/" -> "ar")
						const locale = newPath.split('/')[1];
						if (locale) {
							// Set cookie for 1 year
							document.cookie = `starlight-locale=${locale}; max-age=31536000; path=/; SameSite=Lax`;
						}
						window.location.pathname = newPath;
					}
				});
				window.addEventListener('pageshow', (event) => {
					if (!event.persisted) return;
					const markupSelectedIndex =
						select.querySelector<HTMLOptionElement>('option[selected]')?.index;
					if (markupSelectedIndex !== select.selectedIndex) {
						select.selectedIndex = markupSelectedIndex ?? 0;
					}
				});
			}
		}
	}
	customElements.define('starlight-lang-select', StarlightLanguageSelect);
</script>