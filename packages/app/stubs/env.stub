# Environment variables for this Barq application.
# The framework validates them at boot; the app refuses to start with a
# clear per-variable error when a value is malformed.

# --- Application ---------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000

# Comma-separated list of allowed origins, or "*" to allow all.
APP_CORS_ORIGIN=*

# --- Encryption ----------------------------------------------------------
# Generated by `env:make`; rotate with `bun run cli key:generate`.
APP_KEY="{{appKey}}"
# Retired keys, comma-separated, so rotating keys never breaks stored values.
APP_PREVIOUS_KEYS=

# --- Logging -------------------------------------------------------------
LOG_LEVEL=info

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_STRICT_MAX=20

# --- Idempotency ---------------------------------------------------------
IDEMPOTENCY_TTL_MS=86400000
IDEMPOTENCY_ENFORCE_HEADER=true

# --- Password hashing ----------------------------------------------------
HASH_DRIVER=scrypt
HASH_VERIFY=true

# --- Mail ----------------------------------------------------------------
# The transport is picked automatically: a host means real SMTP delivery,
# no host means the message is printed in the terminal.
MAIL_TRANSPORT=auto
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Barq
MAIL_REPLY_TO=
MAIL_SUBJECT_PREFIX=
MAIL_RETRIES=2
MAIL_RETRY_DELAY=500
