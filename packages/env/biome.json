{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"root": false,
	"files": {
		"includes": [
			"src/**/*.ts",
			"test/**/*.ts",
			"package.json",
			"tsconfig.json"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noConfusingVoidType": "off",
				"noTemplateCurlyInString": "off"
			}
		}
	}
}
