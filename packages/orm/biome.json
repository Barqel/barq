{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"root": false,
	"files": {
		"includes": [
			"src/**/*.ts",
			"tests/**/*.ts",
			"benchmarks/**/*.ts",
			"examples/**/*.ts",
			"package.json",
			"tsconfig.json",
			"tsconfig.test.json"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "off",
				"useImportType": "off",
				"useExportType": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noConfusingVoidType": "off",
				"noTemplateCurlyInString": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/model/model.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"noThisInStatic": "off"
					}
				}
			}
		}
	]
}
